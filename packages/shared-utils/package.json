{
  "name": "@kotiz/shared-utils",
  "version": "0.1.0",
  "private": true,
  "description": "Utilitaires TypeScript partagés mobile + admin-web : format FCFA, validation E.164 (CI), constants RBAC, etc.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "echo \"(no build step — TS source consommée directement par bundlers Metro/Next)\"",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "node --experimental-test-coverage --test-coverage-include='src/*.ts' --test-coverage-exclude='src/index.ts' --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 --test test/*.test.ts",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "~5.6.3"
  }
}
