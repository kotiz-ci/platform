{
  "name": "@kotiz/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "KOTIZ design tokens — source de vérité (palette v2 + 4 ajouts WCAG AA), consommé par mobile (RN/Expo via NativeWind) + admin-web (Next.js Tailwind).",
  "main": "./dist/tokens.js",
  "module": "./dist/tokens.mjs",
  "types": "./dist/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.mjs",
      "require": "./dist/tokens.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.mjs",
      "require": "./dist/theme.js"
    },
    "./css": "./dist/tokens.css",
    "./json": "./dist/tokens.json",
    "./tailwind": "./dist/tailwind-preset.js"
  },
  "files": [
    "dist",
    "tokens.json"
  ],
  "scripts": {
    "prepare": "node scripts/build-tokens.mjs",
    "build": "node scripts/build-tokens.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint scripts --max-warnings 0",
    "test": "node --experimental-test-coverage --test-coverage-include='scripts/*.mjs' --test-coverage-exclude='scripts/*.test.mjs' --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 --test scripts/token-validation.test.mjs",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "~5.6.3"
  }
}
