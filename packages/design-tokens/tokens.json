{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "KOTIZ Palette v2 — 13 v2 + 4 nouveaux (Story 1.1 AC7 + ADR-009 + UX Spec §3.5). Validé 23 avril 2026, mis à jour 7 mai 2026.",
  "color": {
    "$type": "color",
    "navy": {
      "$value": "#0A2540",
      "$description": "Brand primary — logo, headlines, dark surfaces"
    },
    "teal": {
      "$value": "#00A896",
      "$description": "Brand secondary — illustrations, decorative"
    },
    "teal-deep": {
      "$value": "#007A6E",
      "$description": "Primary action (boutons cliquables, links) — WCAG AA contrast ≥ 4,5:1 sur cream/surface"
    },
    "teal-50": {
      "$value": "#E6F4F2",
      "$description": "Teal background (info banners, tags)"
    },
    "teal-100": {
      "$value": "#B3DDD8",
      "$description": "Teal hover / active state"
    },
    "gold": {
      "$value": "#D4A017",
      "$description": "Brand accent — score étoiles, badges"
    },
    "gold-dark": {
      "$value": "#B8860B",
      "$description": "Gold text on light surfaces — WCAG AA"
    },
    "gold-50": {
      "$value": "#FBF4E0",
      "$description": "Gold background (premium banners, score promos)"
    },
    "cream": {
      "$value": "#FAF7F2",
      "$description": "App background (chaleureux, lecture en plein soleil Adjamé)"
    },
    "surface": {
      "$value": "#FFFFFF",
      "$description": "Card / modal surface"
    },
    "ink-900": {
      "$value": "#0E1B1A",
      "$description": "Primary text — corps, headings"
    },
    "ink-700": {
      "$value": "#3D4F4D",
      "$description": "Secondary text — sous-titres, métadonnées"
    },
    "ink-500": {
      "$value": "#6B7B79",
      "$description": "Tertiary text — placeholders, helper"
    },
    "ink-300": {
      "$value": "#B5C0BE",
      "$description": "Disabled / dividers / borders subtils"
    },
    "success": {
      "$value": "#10B981",
      "$description": "Positive states — dépôt confirmé, palier atteint"
    },
    "info": {
      "$value": "#3B82F6",
      "$description": "Informational — astuces, notifications neutres"
    },
    "danger": {
      "$value": "#DC2626",
      "$description": "Errors — échec, retry, suppression"
    }
  },
  "font-family": {
    "$type": "fontFamily",
    "sans": {
      "$value": ["Inter_400Regular", "system-ui", "sans-serif"],
      "$description": "Texte courant"
    },
    "medium": {
      "$value": ["Inter_500Medium", "system-ui", "sans-serif"]
    },
    "semibold": {
      "$value": ["Inter_600SemiBold", "system-ui", "sans-serif"]
    },
    "bold": {
      "$value": ["Inter_700Bold", "system-ui", "sans-serif"]
    },
    "extrabold": {
      "$value": ["Inter_800ExtraBold", "system-ui", "sans-serif"]
    }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "6px" },
    "md": { "$value": "10px" },
    "lg": { "$value": "16px" },
    "xl": { "$value": "24px" },
    "full": { "$value": "9999px" }
  },
  "spacing": {
    "$type": "dimension",
    "xs": { "$value": "4px" },
    "sm": { "$value": "8px" },
    "md": { "$value": "16px" },
    "lg": { "$value": "24px" },
    "xl": { "$value": "32px" },
    "2xl": { "$value": "48px" },
    "3xl": { "$value": "64px" }
  }
}
