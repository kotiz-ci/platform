{
  "name": "kotiz",
  "version": "0.1.0",
  "private": true,
  "description": "KOTIZ — Plateforme micro-épargne CI (monorepo Turborepo, cf. ADR-008 + ADR-009)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": "24.21.0",
    "pnpm": "9.12.3"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "pnpm test:repo && turbo run test",
    "test:repo": "node --experimental-test-coverage --test-coverage-include='scripts/*.mjs' --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 --test tests/*.test.mjs scripts/*.test.mjs",
    "test:story-1.1": "node --test tests/story-1.1-smoke.test.mjs",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "dev": "turbo run dev",
    "clean": "turbo run clean && rm -rf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .prettierignore",
    "format:check:affected": "node scripts/check-affected-format.mjs",
    "lint:markdown:affected": "node scripts/check-affected-markdown.mjs",
    "coverage:scope:affected": "node scripts/check-coverage-scope.mjs",
    "coverage:scope:promotion": "node scripts/check-coverage-scope.mjs --promotion",
    "verify:github-flow": "node scripts/verify-github-flow.mjs",
    "verify:local-dev": "bash scripts/verify-local-dev.sh",
    "test:github-flow": "node --test scripts/verify-github-flow.test.mjs",
    "test:issue-autoclose": "node --test scripts/close-linked-issues.test.mjs",
    "prepare": "husky || true",
    "dev:up": "bash infra/docker/dev-up.sh",
    "dev:down": "docker compose -f infra/docker/docker-compose.dev.yml down",
    "dev:logs": "docker compose -f infra/docker/docker-compose.dev.yml logs -f",
    "dev:reset": "docker compose -f infra/docker/docker-compose.dev.yml down -v"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "9.39.5",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "markdownlint-cli2": "0.18.1",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "~5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
