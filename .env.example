# KOTIZ — variables d'environnement dev local (Story 1.3a phase 1)
# ATTENTION : ce fichier est COMMITÉ. Ne JAMAIS y mettre de vrais secrets.
# Le vrai .env est git-ignoré et généré par `cp .env.example .env`.

# ----- App env -----
NODE_ENV=development

# ----- Backend (Spring Boot) -----
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# ----- Database -----
# Les paramètres non sensibles sont définis dans Compose. Le mot de passe est
# généré dans infra/docker/secrets-dev/ par `pnpm dev:up` et n'entre jamais dans .env.

# ----- Mobile (RN/Expo) -----
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# ----- Admin web (Next.js) -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ----- Crypto (Story 1.4 — AES-256-GCM PII) -----
# Clé factice 32 bytes base64 — générée par init-dev-secrets.sh (décode bien en 32 octets)
KOTIZ_AES_MASTER_KEY=a290aXotZGV2LW9ubHktY2hhbmdlLW1lLWFlcy0yNTY=

# ----- Observabilité (Story 1.5 — désactivée par défaut en dev) -----
LOKI_PUSH_URL=
PROMETHEUS_PUSH_URL=
