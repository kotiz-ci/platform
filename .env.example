# KOTIZ — variables d'environnement dev local (Story 1.3a phase 1)
# ATTENTION : ce fichier est COMMITÉ. Ne JAMAIS y mettre de vrais secrets.
# Le vrai .env est git-ignoré et généré par `cp .env.example .env`.

# ----- App env -----
NODE_ENV=development

# ----- Backend (Spring Boot) -----
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ----- Database (Story 1.3a + 1.4) -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=kotiz_dev
POSTGRES_USER=kotiz
# Mot de passe factice — généré par init-dev-secrets.sh
POSTGRES_PASSWORD=dev-only-change-me

# ----- Redis (Story 1.3a) -----
REDIS_HOST=localhost
REDIS_PORT=6379

# ----- MinIO (Story 1.3a — KYC + audio WA) -----
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=kotiz-dev
MINIO_SECRET_KEY=dev-only-change-me

# ----- Mobile (RN/Expo) -----
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# ----- Admin web (Next.js) -----
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ----- Crypto (Story 1.4 — AES-256-GCM PII) -----
# Clé factice 32 bytes base64 — générée par init-dev-secrets.sh
KOTIZ_AES_MASTER_KEY=ZGV2LW9ubHktY2hhbmdlLW1lLWFlc18yNTYta2V5IQ==

# ----- Observabilité (Story 1.5 — désactivée par défaut en dev) -----
LOKI_PUSH_URL=
PROMETHEUS_PUSH_URL=
