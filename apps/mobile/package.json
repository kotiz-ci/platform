{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "description": "KOTIZ mobile — React Native + Expo SDK 54 (cf. ADR-009). Cliente + Agent dans un seul codebase via Expo Router groups.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "EXPO_PUBLIC_APP_VARIANT=${EXPO_PUBLIC_APP_VARIANT:-client} expo start --clear",
    "dev:client": "EXPO_PUBLIC_APP_VARIANT=client expo start --clear",
    "dev:agent": "EXPO_PUBLIC_APP_VARIANT=agent expo start --clear",
    "android:client": "EXPO_PUBLIC_APP_VARIANT=client expo start --android",
    "android:agent": "EXPO_PUBLIC_APP_VARIANT=agent expo start --android",
    "ios:client": "EXPO_PUBLIC_APP_VARIANT=client expo start --ios",
    "ios:agent": "EXPO_PUBLIC_APP_VARIANT=agent expo start --ios",
    "web:client": "EXPO_PUBLIC_APP_VARIANT=client expo start --web",
    "web:agent": "EXPO_PUBLIC_APP_VARIANT=agent expo start --web",
    "build": "pnpm run build:web:client && pnpm run build:web:agent",
    "build:web:client": "EXPO_PUBLIC_APP_VARIANT=client expo export --platform web",
    "build:web:agent": "EXPO_PUBLIC_APP_VARIANT=agent expo export --platform web",
    "build:preview:client": "pnpm dlx eas-cli@latest build --profile=preview-client --non-interactive",
    "build:preview:agent": "pnpm dlx eas-cli@latest build --profile=preview-agent --non-interactive",
    "build:production:client": "pnpm dlx eas-cli@latest build --profile=production-client --non-interactive",
    "build:production:agent": "pnpm dlx eas-cli@latest build --profile=production-agent --non-interactive",
    "type-check": "pnpm run type-check:client && pnpm run type-check:agent",
    "type-check:client": "EXPO_PUBLIC_APP_VARIANT=client tsc --noEmit",
    "type-check:agent": "EXPO_PUBLIC_APP_VARIANT=agent tsc --noEmit",
    "lint": "eslint app lib app.config.ts --max-warnings 0",
    "test": "node --experimental-test-module-mocks --experimental-test-coverage --test-coverage-include='lib/variant*.ts' --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 --test test/*.test.ts",
    "clean": "rm -rf .expo node_modules dist"
  },
  "dependencies": {
    "@kotiz/api-types": "workspace:*",
    "@kotiz/design-tokens": "workspace:*",
    "@kotiz/shared-utils": "workspace:*",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@gorhom/bottom-sheet": "^5.2.13",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^1.14.0",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "0.2.6",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.3"
  }
}
