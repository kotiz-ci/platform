{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "description": "KOTIZ mobile — React Native + Expo SDK 54 (cf. ADR-009). Cliente + Agent dans un seul codebase via Expo Router groups.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "test": "jest --passWithNoTests",
    "clean": "rm -rf .expo node_modules dist"
  },
  "dependencies": {
    "@kotiz/api-types": "workspace:*",
    "@kotiz/design-tokens": "workspace:*",
    "@kotiz/shared-utils": "workspace:*",
    "@expo-google-fonts/inter": "^0.4.2",
    "@gorhom/bottom-sheet": "^5.2.13",
    "expo": "~55.0.23",
    "expo-constants": "~55.0.16",
    "expo-font": "~55.0.7",
    "expo-haptics": "~55.0.14",
    "expo-linking": "~55.0.15",
    "expo-router": "~55.0.14",
    "expo-splash-screen": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "lucide-react-native": "^1.14.0",
    "nativewind": "^4.2.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.12.1",
    "react-native-worklets": "^0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.10",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.3"
  }
}
