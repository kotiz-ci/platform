{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "_base": {
      "node": "24.21.0",
      "pnpm": "9.12.3",
      "env": {
        "EXPO_NO_DOTENV": "1"
      }
    },

    "development-client": {
      "extends": "_base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "client"
      }
    },
    "development-agent": {
      "extends": "_base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "agent"
      }
    },

    "preview-client": {
      "extends": "_base",
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "client"
      }
    },
    "preview-agent": {
      "extends": "_base",
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "agent"
      }
    },

    "production-client": {
      "extends": "_base",
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "client"
      }
    },
    "production-agent": {
      "extends": "_base",
      "distribution": "internal",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_VARIANT": "agent"
      }
    }
  },
  "submit": {
    "production-client": {
      "ios": {
        "appleTeamId": "TODO_SPRINT2",
        "bundleIdentifier": "ci.kotiz.client"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "production-agent": {
      "ios": {
        "appleTeamId": "TODO_SPRINT2",
        "bundleIdentifier": "ci.kotiz.agent"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
